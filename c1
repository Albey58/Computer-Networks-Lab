int main(int argc, char *argv[]) {
    int s = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in srv = {0};
    srv.sin_family = AF_INET;
    srv.sin_port = htons(8080);
    inet_pton(AF_INET, argc > 1 ? argv[1] : "127.0.0.1", &srv.sin_addr); // text IP -> binary
    connect(s, (struct sockaddr*)&srv, sizeof srv);     // three-way handshake

    int n, m[50*50];
    do { printf("Enter N (1-50): "); scanf("%d", &n); } while (n < 1 || n > 50); // validate range
    printf("Enter %d elements:\n", n*n);
    for (int i = 0; i < n*n; i++) scanf("%d", &m[i]);   // user input (instead of rand())

    send(s, &n, sizeof n, 0);                           // send order first so server knows how much to read
    send(s, m, n*n*sizeof(int), 0);                     // send flattened matrix
    char res[100];
    recv(s, res, sizeof res, 0);
    printf("Server says: %s\n", res);
    close(s);
}
