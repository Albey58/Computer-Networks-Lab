int main(int argc, char *argv[]) {
    int s = socket(AF_INET, SOCK_DGRAM, 0);
    struct sockaddr_in srv = {0};
    srv.sin_family = AF_INET; srv.sin_port = htons(9090);
    inet_pton(AF_INET, argc > 1 ? argv[1] : "127.0.0.1", &srv.sin_addr);
    char buf[4096];
    printf("Enter sentence: ");
    fgets(buf, 1024, stdin);
    buf[strcspn(buf, "\n")] = 0;                        // strip newline
    sendto(s, buf, strlen(buf), 0, (struct sockaddr*)&srv, sizeof srv); // no connect needed
    int n = recvfrom(s, buf, sizeof buf - 1, 0, NULL, NULL);            // NULL: don't need sender address
    buf[n] = 0;
    printf("Formal: %s\n", buf);
    close(s);
}
